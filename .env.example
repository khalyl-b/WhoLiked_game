# Runtime
GAME_STORAGE=memory
SESSION_SECRET=replace-with-a-long-random-secret

# Choose fake for development fixtures, or tiktok to require imported real TikTok activity.
SOCIAL_ACTIVITY_PROVIDER=fake

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy fallbacks
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# TikTok Login Kit + Data Portability
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-domain.example/api/auth/tiktok/callback
TIKTOK_PORTABILITY_ENABLED=false
TIKTOK_TOKEN_ENCRYPTION_KEY=

# Public operator/legal details shown on Privacy/Terms pages.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Optional observability
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_DSN=
