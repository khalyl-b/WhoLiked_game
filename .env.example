# Runtime
# Use "memory" for zero-setup local tests. Set this to "supabase" on Vercel.
# Production intentionally refuses to run with memory storage.
GAME_STORAGE=memory
SESSION_SECRET=replace-with-a-long-random-secret

# Supabase (recommended current key format)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy Supabase keys are still accepted as fallbacks during migration.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# TikTok Login Kit / provider. Optional until approved credentials exist.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-registered-https-domain.example/api/auth/tiktok/callback
# Recommended once TikTok OAuth is enabled. If blank, SESSION_SECRET is used as a fallback.
TIKTOK_TOKEN_ENCRYPTION_KEY=

# Optional observability hooks
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_DSN=
